{
  "name": "routelens",
  "version": "0.3.1",
  "description": "See every URL in your app: the endpoints your server answers, the pages your client serves, and the calls between them, one click from opening any of them.",
  "keywords": [
    "routes",
    "endpoints",
    "pages",
    "api",
    "next",
    "express",
    "fastify",
    "hono",
    "nest",
    "fastapi",
    "react-router",
    "vue-router",
    "devtool",
    "cli"
  ],
  "license": "MIT",
  "author": "Erik Larson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriklarsondev/routelens.git"
  },
  "homepage": "https://github.com/eriklarsondev/routelens#readme",
  "bugs": {
    "url": "https://github.com/eriklarsondev/routelens/issues"
  },
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./fetch": {
      "types": "./dist/server/fetch-handler.d.ts",
      "default": "./dist/server/fetch-handler.js"
    },
    "./vite": {
      "types": "./dist/server/vite.d.ts",
      "default": "./dist/server/vite.js"
    },
    "./scan": {
      "types": "./dist/server/scan.d.ts",
      "default": "./dist/server/scan.js"
    },
    "./package.json": "./package.json",
    "./auto": "./dist/server/auto/preload.cjs",
    "./wire": {
      "types": "./dist/server/auto/wire.d.ts",
      "default": "./dist/server/auto/wire.js"
    }
  },
  "bin": {
    "routelens": "./dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "node scripts/build-server.mjs",
    "build:client": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run typecheck && npm test",
    "test": "npm run build && node scripts/test.mjs",
    "lens": "npm run build && node dist/server/cli.js",
    "postinstall": "node -e \"import('./dist/server/auto/postinstall.js').catch(()=>{})\""
  },
  "devDependencies": {
    "@radix-ui/react-tooltip": "^1.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "hono": "^4.13.13",
    "koa": "^3.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
