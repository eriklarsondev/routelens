{
  "name": "routelens",
  "version": "0.4.0",
  "description": "See every endpoint your Express app answers, and what runs in front of each one, one click from opening any of them.",
  "keywords": [
    "express",
    "routes",
    "endpoints",
    "middleware",
    "api",
    "devtool"
  ],
  "license": "MIT",
  "author": "Erik Larson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriklarsondev/routelens.git"
  },
  "homepage": "https://github.com/eriklarsondev/routelens#readme",
  "bugs": {
    "url": "https://github.com/eriklarsondev/routelens/issues"
  },
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "require": "./dist/server/index.cjs",
      "default": "./dist/server/index.js"
    },
    "./scan": {
      "types": "./dist/server/scan.d.ts",
      "default": "./dist/server/scan.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "node scripts/build-server.mjs",
    "build:client": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run typecheck && npm test",
    "test": "npm run build && node scripts/test.mjs",
    "lens": "npm run build && node scripts/lens.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
